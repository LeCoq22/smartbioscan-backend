# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co/rest/v1/
SUPABASE_SERVICE_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Encriptación credenciales Tanita ─────────────────────────
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=your_64_char_hex_key_here

# ── Auth JWT (Supabase ES256 / JWKS) ─────────────────────────
# URL pública para verificación de JWT. Cambiar si el proyecto Supabase cambia.
SUPABASE_JWKS_URL=https://ivwderljwrwjzmgcmens.supabase.co/auth/v1/.well-known/jwks.json

# ── WhatsApp (WATI) ───────────────────────────────────────────
WATI_API_URL=https://live-server-XXXXX.wati.io
WATI_API_TOKEN=your_wati_jwt_token_here

# Dashboard billing: keep disabled until migration, worker and MP sandbox validation.
BILLING_MANAGEMENT_ENABLED=false
# Set true after applying migrations/20261015130425_dashboard_billing.sql.
# Keep true while disabling purchases if existing billing orders still need processing.
BILLING_SCHEMA_READY=false
# Required business choice before enabling checkout: activation | extend_expiry.
BILLING_EXPIRY_POLICY=activation
